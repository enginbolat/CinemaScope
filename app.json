{
  "expo": {
    "name": "CinemaScope",
    "slug": "cinemascope",
    "scheme": "cinemascope",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-localization"
    ],
    "extra": {
      "router": {
        "root": "app"
      }
    },
    "ios": {
      "bundleIdentifier": "com.cinemascope.app"
    },
    "android": {
      "package": "com.cinemascope.app"
    }
  }
}
