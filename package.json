{
  "name": "CinemaScope",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "eslint:ci": "eslint . --max-warnings 0",
    "eslint:fix": "eslint . --fix",
    "pods": "cd ios && rm -rf Pods/ && pod install --repo-update && cd ..",
    "clean": "cd scripts && bash clean.sh && cd ..",
    "start": "expo start",
    "test": "jest",
    "postinstall": "patch-package",
    "prepare": "husky install"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@gorhom/bottom-sheet": "^5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.6.1",
    "@shopify/flash-list": "2.3.1",
    "axios": "^1.8.4",
    "expo": "~55.0.0",
    "expo-blur": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "^55.0.16",
    "expo-font": "^55.0.7",
    "expo-image": "^55.0.10",
    "expo-linking": "^55.0.15",
    "expo-localization": "~55.0.14",
    "expo-router": "^55.0.14",
    "i18next": "^26.2.0",
    "react": "19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/eslint-config": "^0.83.9",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.10",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^55.0.21",
    "eslint": "^8.19.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-refresh": "^0.14.0",
    "react-test-renderer": "19.2.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18",
    "yarn": ">=1.22.0",
    "npm": "use-yarn-instead"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
